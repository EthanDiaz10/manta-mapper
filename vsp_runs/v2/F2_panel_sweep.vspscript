                vec3d(6.0615795e-21, -9.7832305e-20, 0.0), vec3d(9.0127361e-06, -0.00040011348, 0.0), vec3d(0.00014348717, -0.0015921882, 0.0), vec3d(0.00070463815, -0.0035065053, 0.0), vec3d(0.002057558, -0.0059430344, 0.0), vec3d(0.0044201364, -0.0086289188, 0.0), vec3d(0.0078208095, -0.011362352, 0.0), vec3d(0.012206917, -0.014045861, 0.0), vec3d(0.017518371, -0.016642392, 0.0), vec3d(0.023706208, -0.019139556, 0.0), vec3d(0.030732109, -0.021533457, 0.0), vec3d(0.038564972, -0.023822594, 0.0), vec3d(0.047178109, -0.026005752, 0.0), vec3d(0.056547378, -0.028081364, 0.0), vec3d(0.066649991, -0.030047422, 0.0), vec3d(0.077463753, -0.031901568, 0.0), vec3d(0.088966581, -0.033641222, 0.0), vec3d(0.1011362, -0.035263739, 0.0), vec3d(0.11394992, -0.03676654, 0.0), vec3d(0.12738455, -0.038147232, 0.0), vec3d(0.14141628, -0.039403709, 0.0), vec3d(0.15602067, -0.040534231, 0.0), vec3d(0.17117262, -0.0415375, 0.0), vec3d(0.18684637, -0.042412702, 0.0), vec3d(0.2030155, -0.043159553, 0.0), vec3d(0.21965299, -0.043778317, 0.0), vec3d(0.23673119, -0.044269822, 0.0), vec3d(0.25422192, -0.044635459, 0.0), vec3d(0.27209644, -0.044877171, 0.0), vec3d(0.29032555, -0.044997438, 0.0), vec3d(0.30887957, -0.044999244, 0.0), vec3d(0.32772843, -0.04488605, 0.0), vec3d(0.34684169, -0.044661747, 0.0), vec3d(0.36618859, -0.04433062, 0.0), vec3d(0.38573807, -0.043897294, 0.0), vec3d(0.40545885, -0.043366691, 0.0), vec3d(0.42531946, -0.042743976, 0.0), vec3d(0.44528824, -0.042034508, 0.0), vec3d(0.46533347, -0.041243796, 0.0), vec3d(0.48542332, -0.040377449, 0.0), vec3d(0.50552596, -0.039441136, 0.0), vec3d(0.52560957, -0.038440545, 0.0), vec3d(0.54564241, -0.037381353, 0.0), vec3d(0.56559282, -0.036269191, 0.0), vec3d(0.58542933, -0.035109623, 0.0), vec3d(0.60512064, -0.033908123, 0.0), vec3d(0.62463571, -0.032670064, 0.0), vec3d(0.64394377, -0.031400707, 0.0), vec3d(0.66301441, -0.030105194, 0.0), vec3d(0.68181759, -0.028788548, 0.0), vec3d(0.7003237, -0.027455676, 0.0), vec3d(0.7185036, -0.026111374, 0.0), vec3d(0.73632866, -0.024760335, 0.0), vec3d(0.75377083, -0.023407159, 0.0), vec3d(0.77080266, -0.022056362, 0.0), vec3d(0.78739735, -0.020712388, 0.0), vec3d(0.80352881, -0.019379619, 0.0), vec3d(0.81917166, -0.018062384, 0.0), vec3d(0.83430133, -0.016764968, 0.0), vec3d(0.84889403, -0.015491613, 0.0), vec3d(0.86292686, -0.014246525, 0.0), vec3d(0.87637778, -0.013033871, 0.0), vec3d(0.88922571, -0.011857773, 0.0), vec3d(0.90145052, -0.010722307, 0.0), vec3d(0.91303304, -0.0096314852, 0.0), vec3d(0.92395516, -0.0085892464, 0.0), vec3d(0.93419981, -0.0075994374, 0.0), vec3d(0.94375098, -0.0066657929, 0.0), vec3d(0.95259376, -0.0057919141, 0.0), vec3d(0.96071437, -0.0049812441, 0.0), vec3d(0.96810015, -0.0042370426, 0.0), vec3d(0.97473961, -0.0035623603, 0.0), vec3d(0.98062242, -0.0029600124, 0.0), vec3d(0.98573945, -0.0024325534, 0.0), vec3d(0.99008275, -0.0019822529, 0.0), vec3d(0.99364557, -0.0016110728, 0.0), vec3d(0.9964224, -0.0013206477, 0.0), vec3d(0.99840893, -0.0011122676, 0.0), vec3d(0.99960208, -0.00098686397, 0.0), vec3d(1, -0.000945, 0.0)
            };
            string xsec_surf = GetXSecSurf( wid, 1 );
            xsec_surf = GetXSecSurf( wid, 1 );
            string xsec = GetXSec( xsec_surf, 1 );
            SetParmVal( wid, "ThickChord", "XSecCurve_1", 0.5 ); // This is a hack that triggers VSP to update the curve
            SetParmVal( wid, "ThickChord", "XSecCurve_1", 1.0 );
            SetAirfoilPnts( xsec, up_pnt_vec, lo_pnt_vec );
            Update();
        }
        SetParmVal( wid, "Tess_W", "Shape", 100 );
        Update();

    }
    
    //==== Check For API Errors ====//
    while ( GetNumTotalErrors() > 0 )
    {
        ErrorObj err = PopLastError();
        Print( err.GetErrorString() );
    }

    {
        array<string> @geomids = FindGeoms();
    
        for (uint i = 0; i < geomids.length(); i++)
        {
            SetGeomDrawType( geomids[i], GEOM_DRAW_SHADE );
        }
    }
        


    //==== Mesh: about 15 mm spanwise panels, 41 chordwise points ====//
    array<string> geoms = FindGeoms();
    for ( int g = 0; g < int(geoms.size()); g++ )
    {
        SetParmVal( geoms[g], "Tess_W", "Shape", 41 );
        int nx = GetNumXSec( GetXSecSurf( geoms[g], 0 ) );
        for ( int i = 1; i < nx; i++ )
        {
            string grp = "XSec_" + i;
            double span = GetParmVal( geoms[g], "Span", grp );
            int n = int( span / 0.015000 ) + 3;
            SetParmVal( geoms[g], "SectTess_U", grp, n );
        }
        Update();
        Print( "GEOM " + GetGeomName( geoms[g] ) + " TotalArea " + GetParmVal( geoms[g], "TotalArea", "WingGeom" )
               + " TotalProjectedSpan " + GetParmVal( geoms[g], "TotalProjectedSpan", "WingGeom" ) );
    }
    Update();

    SetVSP3FileName( "F2_panel_sweep.vsp3" );
    WriteVSPFile( "F2_panel_sweep.vsp3", SET_ALL );

    //==== Geometry for VSPAERO (panel) ====//
    // OpenVSP 3.57: VLM vs panel is chosen only by the sets (thin = VLM, thick = panel);
    // stability derivatives are switched on with UnsteadyType = STABILITY_DEFAULT.
    array<int> thick = { SET_ALL };
    array<int> thin = { SET_NONE };
    string cg = "VSPAEROComputeGeometry";
    SetAnalysisInputDefaults( cg );
    SetIntAnalysisInput( cg, "GeomSet", thick );
    SetIntAnalysisInput( cg, "ThinGeomSet", thin );
    string rcg = ExecAnalysis( cg );

    //==== Solver ====//
    string sw = "VSPAEROSweep";
    SetAnalysisInputDefaults( sw );
    SetIntAnalysisInput( sw, "GeomSet", thick );
    SetIntAnalysisInput( sw, "ThinGeomSet", thin );
    array<int> manual = { MANUAL_REF };
    SetIntAnalysisInput( sw, "RefFlag", manual );
    array<double> sref = { 0.424478 };
    array<double> bref = { 1.842469 };
    array<double> cref = { 0.264093 };
    array<double> xcg = { 0.266621 };
    array<double> zero = { 0.0 };
    SetDoubleAnalysisInput( sw, "Sref", sref );
    SetDoubleAnalysisInput( sw, "bref", bref );
    SetDoubleAnalysisInput( sw, "cref", cref );
    SetDoubleAnalysisInput( sw, "Xcg", xcg );
    SetDoubleAnalysisInput( sw, "Ycg", zero );
    SetDoubleAnalysisInput( sw, "Zcg", zero );
    array<double> a0 = { -2.0000 };
    array<double> a1 = { 10.0000 };
    array<int> na = { 7 };
    array<double> mach = { 0.04002 };
    array<int> one = { 1 };
    array<double> b0 = { 0.0000 };
    array<double> b1 = { 0.0000 };
    array<int> nb = { 1 };
    array<double> re = { 195723.8 };
    array<double> vinf = { 14.0000 };
    array<double> rho = { 0.98855 };
    SetDoubleAnalysisInput( sw, "AlphaStart", a0 );
    SetDoubleAnalysisInput( sw, "AlphaEnd", a1 );
    SetIntAnalysisInput( sw, "AlphaNpts", na );
    SetDoubleAnalysisInput( sw, "BetaStart", b0 );
    SetDoubleAnalysisInput( sw, "BetaEnd", b1 );
    SetIntAnalysisInput( sw, "BetaNpts", nb );
    SetDoubleAnalysisInput( sw, "MachStart", mach );
    SetDoubleAnalysisInput( sw, "MachEnd", mach );
    SetIntAnalysisInput( sw, "MachNpts", one );
    SetDoubleAnalysisInput( sw, "ReCref", re );
    SetDoubleAnalysisInput( sw, "Vinf", vinf );
    SetDoubleAnalysisInput( sw, "Rho", rho );
    array<int> wake = { 5 };
    SetIntAnalysisInput( sw, "WakeNumIter", wake );
    array<int> ncpu = { 4 };
    SetIntAnalysisInput( sw, "NCPU", ncpu );
    array<int> stab = { STABILITY_OFF };
    SetIntAnalysisInput( sw, "UnsteadyType", stab );
    PrintAnalysisInputs( sw );
    string rid = ExecAnalysis( sw );
    WriteResultsCSVFile( rid, "F2_panel_sweep_results.csv" );
    Print( "DONE F2_panel_sweep" );
}
